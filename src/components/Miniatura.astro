---
// Miniatura sencilla por historia (SVG ligero; se reemplazará por arte propio de cada historia).
import type { Entrada } from "../data/catalog";
interface Props { h: Entrada }
const { h } = Astro.props;
const INK = "#2A1A14";
const fondos: Record<string, string> = { luna: "#2B2F3A", marte: "#C1440E", "espacio-profundo": "#2A1B5E" };
---
<svg class="miniatura" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="12" fill={fondos[h.destino]} />
  {h.id === "spirit-opportunity" && (
    <g>
      <rect x="0" y="44" width="64" height="20" fill="#9E3E22" />
      <g stroke={INK} stroke-width="1.5">
        <rect x="10" y="30" width="18" height="11" rx="2" fill="#F3EFE6" /><rect x="10" y="37" width="18" height="4" fill="#E07B39" />
        <rect x="17" y="20" width="3" height="10" fill="#E6E0D4" /><rect x="12" y="15" width="13" height="7" rx="2" fill="#F3EFE6" />
        <circle cx="13" cy="44" r="3.5" fill="#2E2826" /><circle cx="25" cy="44" r="3.5" fill="#2E2826" />
        <rect x="36" y="30" width="18" height="11" rx="2" fill="#F3EFE6" /><rect x="36" y="37" width="18" height="4" fill="#3FA7A0" />
        <rect x="43" y="20" width="3" height="10" fill="#E6E0D4" /><rect x="38" y="15" width="13" height="7" rx="2" fill="#F3EFE6" />
        <circle cx="39" cy="44" r="3.5" fill="#2E2826" /><circle cx="51" cy="44" r="3.5" fill="#2E2826" />
      </g>
    </g>
  )}
  {h.id === "phoenix-insight" && (
    <g stroke={INK} stroke-width="1.5">
      <rect x="0" y="46" width="64" height="18" fill="#9E3E22" stroke="none" />
      <path d="M8 28 L24 32 L24 38 L8 36 Z M40 32 L56 28 L56 36 L40 38 Z" fill="#3A4150" />
      <rect x="22" y="28" width="20" height="14" rx="3" fill="#F3EFE6" /><path d="M24 42 L18 50 M40 42 L46 50" />
    </g>
  )}
  {h.id === "ingenuity" && (
    <g stroke={INK} stroke-width="1.5">
      <rect x="0" y="50" width="64" height="14" fill="#9E3E22" stroke="none" />
      <path d="M8 16 H56 M12 22 H52" stroke-width="3" /><rect x="30" y="16" width="4" height="10" fill="#E6E0D4" />
      <rect x="24" y="26" width="16" height="12" rx="3" fill="#F3EFE6" /><path d="M26 38 L18 48 M38 38 L46 48" />
    </g>
  )}
  {h.id === "surveyor-3" && (
    <g stroke={INK} stroke-width="1.5">
      <rect x="0" y="46" width="64" height="18" fill="#7D8290" stroke="none" />
      <path d="M22 34 L32 22 L42 34 Z" fill="#D9C27A" /><rect x="26" y="30" width="12" height="10" fill="#C9CCD6" />
      <path d="M26 40 L16 50 M38 40 L48 50" /><rect x="40" y="18" width="14" height="10" fill="#3A4F8C" />
    </g>
  )}
  {h.id === "apollo-11" && (
    <g stroke={INK} stroke-width="1.5">
      <rect x="0" y="48" width="64" height="16" fill="#7D8290" stroke="none" />
      <path d="M20 22 L44 22 L46 36 L18 36 Z" fill="#C9CCD6" /><rect x="20" y="36" width="24" height="8" fill="#D9A93B" />
      <path d="M20 44 L12 52 M44 44 L52 52" />
    </g>
  )}
  {h.id === "pioneer" && (
    <g stroke={INK} stroke-width="1.5">
      <circle cx="12" cy="52" r="3" fill="#B8A9FF" stroke="none" opacity=".6" />
      <path d="M14 50 C28 40 40 30 48 18" stroke="#B8A9FF" stroke-dasharray="3 3" fill="none" />
      <path d="M38 22 A12 12 0 0 1 56 14 Z" fill="#E6E0D4" /><path d="M46 18 L56 30" />
    </g>
  )}
</svg>
